# Charm Email OS - Hypertide Worker
#
# Dedicated worker for domain purchases and inbox provisioning.
# Runs Hypertide browser automation in a separate container from the API.
#
# Features:
# - Processes domain purchase jobs (Dynadot/Porkbun API)
# - Processes inbox setup jobs (Hypertide browser automation)
# - Resilient job processing with retry support
# - Independent deployment from main API
#
# Usage:
#   docker build -t charm-hypertide-worker -f Dockerfile.hypertide-worker .
#   docker run -d \
#     -e POSTGRES_HOST=... -e POSTGRES_PORT=... \
#     -e POSTGRES_DB=... -e POSTGRES_USER=... -e POSTGRES_PASSWORD=... \
#     -e PORKBUN_API_KEY=... -e PORKBUN_API_SECRET=... \
#     -e DYNADOT_API_KEY=... \
#     --restart unless-stopped \
#     charm-hypertide-worker

FROM python:3.11-slim

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies including browser support
RUN apt-get update && apt-get install -y \
    curl \
    procps \
    # Browser dependencies for Hypertide
    chromium \
    chromium-driver \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /app

# Copy requirements first (for layer caching)
COPY requirements-hypertide.txt /app/

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-hypertide.txt

# Set Playwright browsers path BEFORE install so they go to the right place
ENV PLAYWRIGHT_BROWSERS_PATH="/ms-playwright"

# Install Playwright browsers (Chromium only for smaller image)
RUN playwright install chromium --with-deps

# Copy the API services (for Porkbun/Dynadot clients)
COPY api/services/ /app/api/services/

# Create api __init__.py if needed
RUN touch /app/api/__init__.py

# Copy Hypertide automation modules
COPY Hypertide/ /app/Hypertide/

# Copy the worker script
COPY hypertide_worker.py /app/

# Environment variables for database connection
ENV POSTGRES_HOST=""
ENV POSTGRES_PORT="5432"
ENV POSTGRES_DB="postgres"
ENV POSTGRES_USER=""
ENV POSTGRES_PASSWORD=""

# API credentials
ENV PORKBUN_API_KEY=""
ENV PORKBUN_API_SECRET=""
ENV DYNADOT_API_KEY=""

# Worker configuration
ENV POLL_INTERVAL="10"
ENV STALE_JOB_MINUTES="30"
ENV WORKER_ID=""

# Hypertide configuration
ENV HYPERTIDE_HEADLESS="true"
ENV HYPERTIDE_SESSION_B64=""

# Slack notifications
ENV SLACK_ORDERS_WEBHOOK_URL=""

# EmailBison credentials (for Hypertide Email Tool Connection)
ENV EMAILBISON_API_URL=""
ENV EMAILBISON_API_KEY=""
ENV EMAILBISON_USERNAME=""
ENV EMAILBISON_PASSWORD=""

# Health check: verify worker process is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pgrep -f "python.*hypertide_worker.py" || exit 1

# Run the worker
CMD ["python", "/app/hypertide_worker.py"]

# Labels
LABEL org.opencontainers.image.title="Charm Hypertide Worker"
LABEL org.opencontainers.image.description="Domain purchase and inbox provisioning worker"
LABEL org.opencontainers.image.vendor="Charm Email OS"
LABEL org.opencontainers.image.version="1.0.0"
