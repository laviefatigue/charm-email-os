# =============================================================
# Charm Email OS - Environment Variables
# =============================================================
# Copy this file to .env.local for local development
# Copy to .env for production deployment

# =============================================================
# DATABASE CONFIGURATION
# =============================================================
# For LOCAL development (docker-compose.local.yml):
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdevpassword

# For PRODUCTION (OwnRBL PostgreSQL):
# POSTGRES_HOST=31.97.142.123
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_postgres_password_here
# POSTGRES_SCHEMA=public

# =============================================================
# EMAIL BISON API (Required for sync worker)
# =============================================================
# Get your API key from EmailBison dashboard
EMAILBISON_API_KEY=your_api_key_here
EMAILBISON_API_URL=https://spellcast.hirecharm.com

# =============================================================
# FRONTEND CONFIGURATION
# =============================================================
# Port for the Next.js frontend
FRONTEND_PORT=3000

# API URL for browser-side requests
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# =============================================================
# API CONFIGURATION
# =============================================================
# Port for the FastAPI backend
API_PORT=8000

# Debug mode (set to true for development)
DEBUG=false

# =============================================================
# EMAILBISON SYNC WORKER
# =============================================================
# Sync intervals (seconds)
SYNC_INTERVAL_EVENTS=300
SYNC_INTERVAL_FULL=3600
SYNC_INTERVAL_HEALTH=900
SYNC_INTERVAL_KILL=1800

# Data retention (days)
RETENTION_DAYS_AUDIT=90
RETENTION_DAYS_BOUNCES=90

# Alerting (optional)
SLACK_WEBHOOK_URL=

# =============================================================
# STRATEGY WORKER (AI Generation)
# =============================================================
# Claude Code authentication
CLAUDE_ACCOUNT=ClaudeCodeMax

# Worker configuration
POLL_INTERVAL=5
OAUTH_CHECK_INTERVAL=3600

# Generation mode
STRATEGY_LOCAL_MODE=false
STRATEGY_PHASED_MODE=true

# =============================================================
# COOLIFY DEPLOYMENT
# =============================================================
# When deploying to Coolify, set these environment variables
# in the Coolify dashboard:
#
# Required:
#   POSTGRES_HOST=31.97.142.123
#   POSTGRES_PASSWORD=<from-ownrbl-env>
#
# Optional:
#   EMAILBISON_API_KEY=<your-key>
#   FRONTEND_URL=https://charm.yourdomain.com
#   NEXT_PUBLIC_API_URL=https://charm-api.yourdomain.com
