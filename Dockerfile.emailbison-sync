# EmailBison Sync Worker Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements-sync.txt .
RUN pip install --no-cache-dir -r requirements-sync.txt

# Copy sync modules and worker
COPY sync_modules/ ./sync_modules/
COPY emailbison_sync_worker.py .

# Create non-root user for security
RUN useradd -m -u 1000 syncworker
USER syncworker

# Environment defaults
ENV PYTHONUNBUFFERED=1
ENV POSTGRES_HOST=postgres
ENV POSTGRES_PORT=5432
ENV POSTGRES_USER=postgres
ENV POSTGRES_DB=postgres
ENV SYNC_INTERVAL_EVENTS=300
ENV SYNC_INTERVAL_FULL=3600
ENV SYNC_INTERVAL_HEALTH=900
ENV SYNC_INTERVAL_KILL=1800
ENV RETENTION_DAYS_AUDIT=90
ENV RETENTION_DAYS_BOUNCES=90

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import asyncio; import asyncpg; asyncio.run(asyncpg.connect(host='$POSTGRES_HOST', port=$POSTGRES_PORT, user='$POSTGRES_USER', password='$POSTGRES_PASSWORD', database='$POSTGRES_DB'))" || exit 1

# Run the worker
CMD ["python", "emailbison_sync_worker.py"]
