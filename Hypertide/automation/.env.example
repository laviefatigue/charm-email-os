# Hypertide Automation Configuration

# Your Hypertide account email (for reference)
HYPERTIDE_EMAIL=your@email.com

# Browser settings
HYPERTIDE_HEADLESS=false        # Set to 'true' for headless mode
HYPERTIDE_SLOW_MO=100           # Milliseconds to slow down actions (debugging)
HYPERTIDE_TIMEOUT=30000         # Default timeout in milliseconds

# Session storage (optional - defaults to ~/.hypertide/session)
# HYPERTIDE_SESSION_PATH=/path/to/session

# ============================================================================
# Domain Sourcing Configuration
# ============================================================================

# Registrar API Keys (at least one required for domain sourcing)
# Get your Porkbun API keys from: https://porkbun.com/account/api
PORKBUN_API_KEY=pk1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORKBUN_API_SECRET=sk1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get your Dynadot API key from: https://www.dynadot.com/community/developers
DYNADOT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI Domain Generation (optional - fallback patterns used if not set)
# OpenAI API key for GPT-4 domain generation
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Or use Anthropic Claude for generation
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local Ollama (alternative to cloud AI)
# OLLAMA_BASE_URL=http://localhost:11434
