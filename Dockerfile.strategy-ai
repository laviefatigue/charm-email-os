# Charm Email OS - Strategy AI Component
# Purpose-built container for autonomous strategy generation
#
# This container includes:
# - Claude Code CLI (pre-authenticated via volume mount)
# - Strategy skill (Cold Email v2.0)
# - MCP server for database interaction
#
# IMPORTANT: Runs as non-root user 'claude' because Claude Code's
# --dangerously-skip-permissions flag cannot be used with root privileges.
#
# Usage:
#   docker build -t charm-strategy-ai -f Dockerfile.strategy-ai .
#   docker run --rm \
#     -e POSTGRES_HOST=... -e POSTGRES_PORT=... \
#     -e POSTGRES_DB=... -e POSTGRES_USER=... -e POSTGRES_PASSWORD=... \
#     -v /path/to/claude-credentials:/home/claude/.claude \
#     charm-strategy-ai <client_id> <job_id> [submission_id]

FROM debian:bookworm-slim

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    git \
    python3 \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user 'claude' for running Claude Code
# --dangerously-skip-permissions cannot be used with root privileges
RUN useradd -m -s /bin/bash claude && \
    mkdir -p /home/claude/.claude && \
    chown -R claude:claude /home/claude

# Switch to claude user for Claude Code installation
USER claude
WORKDIR /home/claude

# Install Claude Code CLI as non-root user
RUN curl -fsSL https://claude.ai/install.sh | bash

# Add Claude to PATH for the claude user
ENV PATH="/home/claude/.local/bin:${PATH}"

# Switch back to root for system-level operations
USER root

# Set up working directory
WORKDIR /app

# Copy MCP server requirements first (for layer caching)
COPY requirements-mcp.txt /app/

# Install Python MCP dependencies
RUN pip3 install --break-system-packages --no-cache-dir -r requirements-mcp.txt

# Copy MCP server code
COPY strategy_mcp/ /app/strategy_mcp/

# Copy MCP configuration
COPY strategy_mcp_config.json /app/

# Copy Claude skill
COPY .claude/ /app/.claude/

# Make app directory accessible to claude user
RUN chown -R claude:claude /app

# Volume mount point for Claude credentials
# Mount host credentials to /home/claude/.claude (not /root/.claude)
VOLUME /home/claude/.claude

# Environment variables for database connection
# These are passed at runtime
ENV POSTGRES_HOST=""
ENV POSTGRES_PORT="5432"
ENV POSTGRES_DB="postgres"
ENV POSTGRES_USER=""
ENV POSTGRES_PASSWORD=""

# Copy and set up entrypoint
COPY docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

# Switch to non-root user for execution
USER claude

# Default entrypoint: run strategy generation
# Arguments: <client_id> <job_id> [submission_id]
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# NOTE: No HEALTHCHECK - this is a batch job container, not a web service
# It runs once with arguments and exits. Coolify expects HTTP health checks.

# Labels for documentation
LABEL org.opencontainers.image.title="Charm Strategy AI"
LABEL org.opencontainers.image.description="Purpose-built Claude Code container for email strategy generation"
LABEL org.opencontainers.image.vendor="Charm Email OS"
LABEL org.opencontainers.image.version="1.1.0"
