# Dockerfile for Charm Email OS Strategy Worker
# Runs Prefect worker for strategy generation
#
# Note: This container runs the Prefect worker which calls
# claudebox on the host to execute Claude Code commands.
#
# For full containerization, mount Docker socket and install claudebox.

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

# Copy worker code
COPY strategy_worker_prefect.py .
COPY strategy_mcp_config.json .
COPY prefect.yaml .

# Copy MCP server and skill
COPY strategy_mcp/ strategy_mcp/
COPY .claude/ .claude/

# Environment
ENV PREFECT_API_URL=https://prefect.laviefatigue.com/api
ENV USE_DOCKER=false
ENV CLAUDE_ACCOUNT=default

# Default command: start Prefect worker
CMD ["prefect", "worker", "start", "--pool", "default-agent-pool"]
