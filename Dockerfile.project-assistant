# Project Directory Assistant
#
# A containerized Claude Code instance exposed as an MCP server (streamable-http).
# Teammates connect their Claude Code / Claude Desktop to this container
# to query project documentation, architecture, schema, and code.
#
# Generated from project-assistant-template. Configured via project-assistant.yaml.
#
# Build:
#   docker build -t <project>-assistant -f Dockerfile.project-assistant .
#
# Run:
#   docker run -d --name <project>-assistant \
#     -p 3000:3000 \
#     -v claude-credentials:/home/claude/.claude \
#     -v /path/to/project:/app/project:ro \
#     <project>-assistant
#
# First-time auth:
#   docker exec -it <project>-assistant bash
#   claude /login

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    git \
    python3 \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    sudo \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (required for --dangerously-skip-permissions)
RUN useradd -m -s /bin/bash claude && \
    mkdir -p /home/claude/.claude && \
    chown -R claude:claude /home/claude

# Install Claude Code CLI as claude user
USER claude
WORKDIR /home/claude
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/home/claude/.local/bin:${PATH}"

# Back to root for system setup
USER root
WORKDIR /app

# Install Python dependencies for the MCP server
COPY requirements-assistant.txt /app/
RUN pip3 install --break-system-packages --no-cache-dir -r requirements-assistant.txt

# Copy the assistant server
COPY assistant_server.py /app/

# Create directories
RUN mkdir -p /app/project /app/logs && \
    chown -R claude:claude /app

# Volume mount points
VOLUME /home/claude/.claude
VOLUME /app/project
VOLUME /app/logs

# Environment
ENV MCP_TRANSPORT=http
ENV FASTMCP_HOST=0.0.0.0
ENV FASTMCP_PORT=3000
ENV PROJECT_DIR=/app/project
ENV LOG_DB=/app/logs/queries.db
ENV CLAUDE_MAX_TURNS=6
ENV CLAUDE_PROFILE=""
ENV QUERY_TIMEOUT=30
ENV SEARCH_TIMEOUT=15
ENV REQUEST_TIMEOUT=95

# Switch to non-root user
USER claude

# Health check - verify MCP server is responding to HTTP requests
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:3000/mcp -o /dev/null || exit 1

EXPOSE 3000

CMD ["python3", "/app/assistant_server.py"]

LABEL org.opencontainers.image.title="Project Directory Assistant"
LABEL org.opencontainers.image.description="MCP server providing AI-powered project context to teammates via Claude Code"
